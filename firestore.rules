rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profiles collection: public can read, owner can write
    match /profiles/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Usernames mapping: public can read, claim only if free or owned
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && 
                    request.resource.data.uid == request.auth.uid &&
                    (!exists(/databases/$(database)/documents/usernames/$(username)) || resource.data.uid == request.auth.uid);
      allow update: if request.auth != null && 
                    resource.data.uid == request.auth.uid &&
                    request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
